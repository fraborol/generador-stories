# Claves secretas — nunca subir a internet
.env

# Entornos virtuales de Python
.venv/
venv/
env/

# Archivos compilados de Python
__pycache__/
*.pyc
*.pyo

# Caché de Streamlit (se ignora la carpeta completa, excepto la configuración)
.streamlit/
# config.toml debe subirse a GitHub para que Streamlit Cloud lo lea
!.streamlit/config.toml

# Configuración local de herramientas de desarrollo
.claude/

# Sistema operativo
.DS_Store
Thumbs.db
